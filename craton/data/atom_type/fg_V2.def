####################################################### 
### The following section for Relationship Tree #######
#######################################################

ProcedureTree:
(c_
	(c_1(co:C))
	(yne:C
		(cy:C)
		(cum:C)
		(yne_conju:C)
	)
	(ene:C
		(ke:C(fl:C))
		(aim:C)
		(im:C(ox:C)(hz:C))
		(tk:C)
		(ene_conju:C)
	)
	(qc:C
		(tc:C
			(sc:C
				(me:C)
			)
		)
	)
)
(h_(h_1))
(o_
	(o_1
		(ai:O)
	)
	(et:O
		(al:O)
	)
)
(n_
	(n_1)
	(n_2
		(da:N)
		(num:N)
		(ic:N)
		(ni:N)
		(az:N)
	)
	(te:N
		(imp:N)
		(na:N)
		(se:N
			(am:N)
		)
	)
	(n_4
		(amo:N)
		(amp:N)
	)
)
(s_
	(s_1
		(si:S)
	)
	(sm:S
		(th:S)
	)
	(s_3
		(so:S)
	)
	(s_4
		(sa:S)
	)
)
(p_
	(p_2)
	(p_4
		(p4p:P)
		(pa:P)
	)
	(tm:P
		(sm:P
			(ph:P)
		)
	)
)
(f:F)
(cl:Cl)
(br:Br)
(i:I)
(b:B)
(si:Si)
(al:Al)
(fe:Fe)
End

